rules_version = '2';

// Requires a signed-in Firebase Auth session for all Firestore access — this
// app authenticates once via /api/login (which mints a Firebase custom
// token, see api/_lib/firebaseAdminAuth.js) rather than using Firebase Auth's
// own sign-in UI, but the resulting session is a real one that request.auth
// can see.
//
// Deliberately not role-based: this app's per-role permissions (front_office,
// accountant, etc.) are enforced only in the UI today (see
// src/components/UserManagement.jsx's MODULES/DEFAULT_PERMISSIONS), and any
// signed-in staff member already has full data access at the database level
// regardless of role. These rules just close the previous unauthenticated
// public-access hole without changing that existing trust model.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
