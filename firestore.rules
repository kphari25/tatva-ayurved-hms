rules_version = '2';

// Requires a signed-in Firebase Auth session for all Firestore access — this
// app authenticates once via /api/login (which mints a Firebase custom
// token, see api/_lib/firebaseAdminAuth.js) rather than using Firebase Auth's
// own sign-in UI, but the resulting session is a real one that request.auth
// can see.
//
// Deliberately not role-based for ordinary data: this app's per-role
// permissions (front_office, accountant, etc.) are enforced only in the UI
// today (see src/components/UserManagement.jsx's MODULES/DEFAULT_PERMISSIONS),
// and any signed-in staff member already has full data access at the database
// level regardless of role. These rules just close the previous
// unauthenticated public-access hole without changing that existing trust
// model.
//
// The one exception is expense_audit_log (who added / edited which expense):
// any signed-in user can append an entry, but only admins can read it, and
// entries can never be changed or deleted. The role comes from the custom
// token's `role` claim (set in api/login.js). Because Firestore rules are
// additive, the general rule below explicitly skips this collection —
// otherwise it would grant everyone read access to it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'expense_audit_log';
    }

    match /expense_audit_log/{entry} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && request.auth.token.role in ['system_admin', 'admin', 'Admin'];
      allow update, delete: if false;
    }
  }
}
