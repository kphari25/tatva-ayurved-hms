# MSG91 SMS Configuration (India)
# Copy this file to .env and fill in your credentials
# Get API key from: https://control.msg91.com/app/api-keys
VITE_MSG91_AUTH_KEY=your_msg91_auth_key_here
VITE_MSG91_SENDER_ID=TATVAY

# Anthropic API (used to read vendor PDF invoices in Purchase Management > Import Invoice)
# Get API key from: https://console.anthropic.com/settings/keys
# No VITE_ prefix — this is read server-side only, by api/parse-invoice.js,
# so it's never bundled into client code. Set it in Vercel project settings
# (or here, for local `vercel dev` testing) — never as a VITE_-prefixed var.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Signs session tokens issued by api/login.js on successful login, and verifies
# them in api/parse-invoice.js. Any long random string works — generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# No VITE_ prefix — server-side only. Anyone holding this value could forge a
# valid session for any user, so treat it exactly like the Anthropic key.
SESSION_SECRET=your_random_session_secret_here

# WhatsApp Business Cloud API (Meta) — automatic WhatsApp messages via api/send-whatsapp.js
# Server-side only (no VITE_ prefix). Set in Vercel project settings (and here for `vercel dev`).
# Token: Meta Business Settings > System Users > generate token with
#   whatsapp_business_messaging + whatsapp_business_management (permanent, not the 24h test token).
# Phone number ID: developers.facebook.com > your app > WhatsApp > API Setup.
# Templates used (create + get approved in WhatsApp Manager, language "English"):
#   registration_confirmation (2 params), invoice_generated (6 params), appointment_confirmation (5 params)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0
# Set to true only after the WhatsApp Cloud API above is configured; until then the
# Message button just opens WhatsApp via wa.me.
VITE_WHATSAPP_API_ENABLED=false
