# MSG91 SMS Configuration (India)
# Copy this file to .env and fill in your credentials
# Get API key from: https://control.msg91.com/app/api-keys
VITE_MSG91_AUTH_KEY=your_msg91_auth_key_here
VITE_MSG91_SENDER_ID=TATVAY

# Anthropic API (used to read vendor PDF invoices in Purchase Management > Import Invoice)
# Get API key from: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
